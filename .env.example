# Supabase — waitlist email collection
# Reuses the rooted-app Supabase project. Copy these from rooted-app/.env.local.
# Run the table + INSERT policy first — see supabase/waitlist_signups.sql.
#
# The landing page uses ONLY the public anon key. The waitlist table has an
# INSERT-only RLS policy, so this key can add emails but cannot read the list.
# The service-role key is intentionally NOT used here — that whole-database
# master key stays in rooted-app and never reaches the landing page deployment.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
