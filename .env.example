# Supabase — waitlist email collection
# Reuses the rooted-app Supabase project. Copy these from rooted-app/.env.local.
# Create the table first — see supabase/waitlist_signups.sql.
#
# The waitlist API route (app/api/waitlist/route.ts) runs server-side and writes
# with the service-role key, which bypasses RLS. The anon key is not required for
# the waitlist but is conventional to keep for any future client-side use.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — NEVER expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
